# ⚙️ .env.example - Application Configuration Template
# 
# Copy to .env and fill with your values
# cp .env.example .env

# Django Settings
SECRET_KEY=dev-key-change-in-prod-insecure
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS / CSRF (comma-separated)
# Examples: https://main.example.com,https://*.example.com
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Regex list for wildcard domains (optional)
# Example: ^https://.*\.amplifyapp\.com$
CORS_ALLOWED_ORIGIN_REGEXES=^https://.*\.netlify\.app$
CSRF_TRUSTED_ORIGINS=http://localhost:5173
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax

# Cloudinary (Image Storage)
# Get credentials at: https://cloudinary.com/
CLOUDINARY_CLOUD_NAME=xxxxxxxxxxxx
CLOUDINARY_API_KEY=xxxxxxxxxxxx
CLOUDINARY_API_SECRET=xxxxxxxxxxxx

# Pusher (Real-time WebSocket Events)
# Get credentials at: https://pusher.com/
PUSHER_APP_ID=xxxxxxx
PUSHER_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
PUSHER_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
PUSHER_CLUSTER=us2

# Admin User Credentials (for init_db.py seed data)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=securepassword123

# Note: Database variables are in config/postgres.env (not here)
